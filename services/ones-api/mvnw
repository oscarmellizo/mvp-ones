#!/bin/sh
#
# Apache Maven Wrapper startup script
#
# Required ENV vars:
#   JAVA_HOME - location of a JDK home dir
#

set -euf

BASE_DIR=$(cd "$(dirname "$0")" && pwd)

MAVEN_WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
PROPERTIES_FILE="$MAVEN_WRAPPER_DIR/maven-wrapper.properties"
JAR_FILE="$MAVEN_WRAPPER_DIR/maven-wrapper.jar"

if [ ! -f "$PROPERTIES_FILE" ]; then
  echo "Missing $PROPERTIES_FILE" >&2
  exit 1
fi

# Read wrapperUrl
WRAPPER_URL=$(grep -E '^wrapperUrl=' "$PROPERTIES_FILE" | cut -d'=' -f2-)
if [ -z "${WRAPPER_URL}" ]; then
  # Default wrapper jar URL
  WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

if [ ! -f "$JAR_FILE" ]; then
  echo "Downloading Maven Wrapper JAR..."
  mkdir -p "$MAVEN_WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$WRAPPER_URL" -o "$JAR_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$WRAPPER_URL" -O "$JAR_FILE"
  else
    echo "Neither curl nor wget is available to download Maven Wrapper" >&2
    exit 1
  fi
fi

exec java -classpath "$JAR_FILE" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
