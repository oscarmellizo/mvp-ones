  "item": [
    {
      "name": "00 - Auth (Google)",
      "item": [
        {
          "name": "Google OAuth Token (exchange auth code)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": {
              "raw": "https://oauth2.googleapis.com/token",
              "protocol": "https",
              "host": ["oauth2", "googleapis", "com"],
              "path": ["token"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "authorization_code" },
                { "key": "client_id", "value": "{{googleClientId}}" },
                { "key": "client_secret", "value": "{{googleClientSecret}}" },
                { "key": "redirect_uri", "value": "{{googleRedirectUri}}" },
                { "key": "code", "value": "{{googleAuthCode}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "const idToken = data && data.id_token ? data.id_token : null;",
                  "const accessToken = data && data.access_token ? data.access_token : null;",
                  "if (idToken) { pm.collectionVariables.set('token', idToken); }",
                  "else if (accessToken) { pm.collectionVariables.set('token', accessToken); }",
                  "pm.collectionVariables.set('google_id_token', idToken || '');",
                  "pm.collectionVariables.set('google_access_token', accessToken || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Set Token (manual)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use this request to paste your token into the collection variable 'token' manually.",
                  "// In Postman UI: Collection -> Variables -> token"
                ]
              }
            }
          ]
        }
      ]
    },
